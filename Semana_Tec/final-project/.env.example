# Dev (local docker compose)
# VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/cancha-viva
# Production (set this before running npm run build)
VITE_N8N_WEBHOOK_URL=https://canchaviva.daifo.net/webhook/cancha-viva

# ── n8n Docker Compose ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=changeme-generate-with-openssl-rand-hex-32
OPENROUTER_API_KEY=sk-or-...

POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme
POSTGRES_DB=n8n

# Public-facing URL for webhook generation — Cloudflare tunnel domain
WEBHOOK_URL=https://n8n.daifo.net
N8N_HOST=0.0.0.0
